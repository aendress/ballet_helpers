				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/usr/bin/env bash
set -euo pipefail

# --- init for -u ---
PLAY_PID=""
FILES=()
STOPPER_PID=""

cleanup() {
  # stop any current audio
  if [ -n "${PLAY_PID:-}" ] &amp;&amp; kill -0 "$PLAY_PID" 2&gt;/dev/null; then
    kill "$PLAY_PID" 2&gt;/dev/null || true
    wait "$PLAY_PID" 2&gt;/dev/null || true
  fi
  # remove temp files
  for f in "${FILES[@]:-}"; do
    rm -f "$f"
  done
  # close Stop dialog if still open
  if [ -n "${STOPPER_PID:-}" ] &amp;&amp; kill -0 "$STOPPER_PID" 2&gt;/dev/null; then
    kill "$STOPPER_PID" 2&gt;/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

# --- GUI prompts (no CLI args) ---
ask_interval() {
  /usr/bin/osascript &lt;&lt;'APPLESCRIPT'
    repeat
      set dlg to display dialog ¬
        "At which interval should words be enunciated (in seconds):" ¬
        default answer "" buttons {"Cancel", "OK"} default button "OK"
      set ans to text returned of dlg
      if ans is not "" then return ans
    end repeat
APPLESCRIPT
}

ask_words() {
  /usr/bin/osascript &lt;&lt;'APPLESCRIPT'
    set dlg to display dialog ¬
      "Which words to enunciate? Use commas, or press OK for the default (left, right):" ¬
      default answer "" buttons {"Cancel", "OK"} default button "OK"
    return text returned of dlg
APPLESCRIPT
}

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

INTERVAL="$(ask_interval)"
/usr/bin/awk -v v="$INTERVAL" 'BEGIN{exit !(v+0&gt;0)}' || {
  /usr/bin/osascript -e 'display alert "Please enter a positive number (&gt; 0) for the interval."'
  exit 1
}

WORDS_INPUT="$(ask_words)"
if [ -z "$WORDS_INPUT" ]; then
  WORDS=("left" "right")
else
  IFS=',' read -r -a raw_words &lt;&lt;&lt; "$WORDS_INPUT"
  WORDS=()
  for w in "${raw_words[@]}"; do
    t="$(trim "$w")"
    [ -n "$t" ] &amp;&amp; WORDS+=("$t")
  done
  [ ${#WORDS[@]} -eq 0 ] &amp;&amp; WORDS=("left" "right")
fi
NWORDS=${#WORDS[@]}

# --- speech rate heuristic ---
if (( $(/usr/bin/bc -l &lt;&lt;&lt; "$INTERVAL &lt; 0.20") )); then
  RATE=550
elif (( $(/usr/bin/bc -l &lt;&lt;&lt; "$INTERVAL &lt; 0.40") )); then
  RATE=450
else
  RATE=350
fi

# --- pre-render clips ---
for w in "${WORDS[@]}"; do
  safe="${w//[^A-Za-z0-9_]/_}"
  f="$(/usr/bin/mktemp "/tmp/${safe}.XXXXXX.aiff")"
  /usr/bin/say -r "$RATE" -o "$f" "$w"
  FILES+=("$f")
done

# --- show persistent Stop button (non-blocking) ---
/usr/bin/osascript &lt;&lt;'APPLESCRIPT' &amp;
display dialog "Directions is running.
Click Stop to quit." buttons {"Stop"} default button "Stop" with icon note
APPLESCRIPT
STOPPER_PID=$!

# --- main loop; runs until Stop dialog is closed ---
while kill -0 "$STOPPER_PID" 2&gt;/dev/null; do
  file="${FILES[$((RANDOM % NWORDS))]}"

  # stop overlapping audio
  if [ -n "${PLAY_PID:-}" ] &amp;&amp; kill -0 "$PLAY_PID" 2&gt;/dev/null; then
    kill "$PLAY_PID" 2&gt;/dev/null || true
    wait "$PLAY_PID" 2&gt;/dev/null || true
  fi

  /usr/bin/afplay "$file" &amp;
  PLAY_PID=$!

  /bin/sleep "$INTERVAL"
done

# optional friendly goodbye
/usr/bin/osascript -e 'display notification "Stopped." with title "Directions"'</string>
					<key>CheckedForUserDefaultShell</key>
